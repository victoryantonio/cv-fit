# Copy to .env and fill in. Never commit .env.
# Every value here is a default; the same defaults are in backend/app/config.py.

DATABASE_URL=sqlite:///data/app.db
DATA_DIR=data

# OpenAI-compatible endpoint. No tools are ever attached to JD/CV calls.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_CONCURRENCY=2
MATCH_RUNS=3

# Comma-separated. The backend never contacts these hosts.
BLOCKED_FETCH_HOSTS=linkedin.com
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

COVER_NOTE_MIN_WORDS=60
COVER_NOTE_MAX_WORDS=150

# OAuth client file lives outside the repo; tokens live in the OS keychain.
GMAIL_CLIENT_SECRET_PATH=
GMAIL_MCP_COMMAND=python -m mcp_gmail

# 0 = no cap.
TOKEN_BUDGET_MONTHLY=0
LOG_LEVEL=INFO
